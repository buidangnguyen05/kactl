{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CP C++ build task",
            "type": "shell",
            "command": "cd ${fileDirname} && g++ -std=c++17 -Wall -O2 -DLOCAL_MACHINE \"${file}\" -o \"${fileDirname}/${fileBasenameNoExtension}\" && \"${fileDirname}/${fileBasenameNoExtension}\"",
            "options": {},
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}